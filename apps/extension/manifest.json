{
  "manifest_version": 3,
  "name": "UNO Onchain",
  "version": "1.0.0",
  "description": "Continue your UNO Onchain games while you work.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://api.unochain.gg/*",
    "https://unochain.gg/*",
    "http://localhost:3001/*",
    "http://localhost:5173/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://unochain.gg/*", "http://localhost:5173/*"],
      "js": ["src/content/inject.ts"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
